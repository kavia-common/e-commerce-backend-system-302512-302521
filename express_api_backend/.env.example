# Server runtime (required)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Feature configuration (required for DB + Auth routes; service can still boot without these)
# Use the raw connection string from database/db_connection.txt (remove the leading `psql ` if present)
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_20_chars
