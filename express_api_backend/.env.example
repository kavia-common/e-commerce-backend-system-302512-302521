# Server runtime (required)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Feature configuration (required for DB + Auth routes; service can still boot without these)
# IMPORTANT:
# - This backend expects DATABASE_URL as a standard Postgres connection string.
# - Copy it from: e-commerce-backend-system-302512-302522/database/db_connection.txt
# - That file typically contains a command like: `psql postgresql://...`
# - Remove the leading `psql ` and paste only the URL here.
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# JWT signing secret (required for authenticated routes)
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_20_chars
